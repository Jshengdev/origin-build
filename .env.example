# copy to .env (gitignored). Every value is read by wtdd/config.py; missing required values fail loud.
HUE_BRIDGE_IP=10.66.1.109
HUE_APP_KEY=
# cloud path (only if the Mac cannot reach the bridge on the LAN): register a Remote Hue API app at
# https://developers.meethue.com/my-apps/ with callback http://localhost:8787/callback, then `python -m wtdd.hue remote-auth`
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
HUE_APP_ID=
HUE_REMOTE_TOKEN=
HUE_REMOTE_REFRESH=
UNITREE_ROBOT_IP=
UNITREE_AES_128_KEY=
WTDD_CHAT_GUID=            # chat.guid of the ONE group the dog may post to
WTDD_CHAT_NAME=wtdd test   # that group's display name; both must match (Johnny set THE CASTLE on 2026-09-13)
WTDD_TRIGGERS=what the dog doin,what the dog doing,whats the dog doing,what is the dog doing,wtdd
WTDD_COMMANDS=do a round,lights on,lights off,dim,bright,show,sit,stand,hello,look,status,stop
WTDD_LISTEN_S=120
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.20              # text + agent tool calls: 3.3 s on a tool ask vs 7 s for grok-4.6 (measured 2026-09-13)
OPENROUTER_VISION_MODEL=x-ai/grok-4.20       # image reads: fastest measured on the dog frame (about 1 s), $1.25/M in
TUYA_DEVICE_ID=
TUYA_DEVICE_IP=
TUYA_LOCAL_KEY=
TUYA_VERSION=3.5
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_API_REGION=us
WTDD_WAKE_SHOW=1   # on a wake phrase: reply, play the lights, send the picture
WTDD_AGENT=1   # while armed, a message that is not a fixed command goes to the model, which picks tools
WTDD_ALLOW_SELF=1   # Johnny can wake the dog from his own phone; the dog still ignores its own posts
WTDD_ALARM=1   # a person in the look's frame sounds the alarm (red/blue on the living room, strip 100%) and posts the line
WTDD_ROUND=entity   # entity = the simulated walk drives the lights, dog hand-driven; dog = the API's follower drives the dog and the lights follow it
WTDD_HOUSEMATE_NAMES=teri   # first names the model may guess as owners of socks, cups, clothes (comma list)
WTDD_ROUND_AVOID=1   # 0 = the chat round follows the route without the dog's obstacle-avoidance service (when it does not answer), by explicit choice
# 02 · decide
JEV_API_KEY=   # unset = the DEMO_CACHE stub decides (rows say source=stub); set = Jev decides at every stop (rows say source=live)
JEV_MODEL=typesafe/jev-1.13   # the System One model id sent to wtdd/decide.py JEV_URL
JEV_LIVE=0   # 1 on the CLI (python -m wtdd.decide) refuses to run the stub: exit 2 without a key
WTDD_DECIDE_THRESHOLD=0.7   # needs_person when p is below this: the round asks the group "not sure: ..." with the photo; raise it to ask more
# 04 · nogo
# WTDD_MAP=   # process env only, never here: another map file for the tests and the dry remote (like WTDD_LEDGER); unset = ui/map.json

# S5 · the map scale: pixels per metre on ui/house.svg. Unset keeps 108.5 (a guess). Measure: 108.5 * 445 / the living
# room's width in pixels on the LiDAR scan. The API reads it at start; restart after a change.
WTDD_PX_PER_M=108.5
# 07 · objects
WTDD_CAM_FOV_DEG=   # the camera's horizontal field of view in degrees, UNVERIFIED until measured on the Go2 (a tape at 2 m: fov = 2 atan(width seen / 4)); empty = objects are stored unplaced and GET /dog/objects says why
WTDD_OBJECTS_DRAFT=live   # live = one llm.generate per new object (needs OPENROUTER_API_KEY); stub = the DEMO_CACHE one-liner tagged [stub: no model], rows cached=true source=stub; anything else = every draft FAILED (a failed row each), never live
WTDD_OBJECTS=   # DEMO_CACHE: a GET /dog/objects body served instead of the session (wtdd/dog/fixtures/objects.json) for the page's dry check; empty = live
# 03 · named-person
WTDD_ON_CALL_NAME=     # the named person a flag ("who dis?!" + the photo) goes to, and the default signer of the shift (record_sign)
WTDD_ON_CALL_HANDLE=   # their handle exactly as chat.db stores it (E.164 or email); the flag goes to the 1:1 chat any;-;<handle>, never the group
WTDD_ON_CALL_GUID=     # S10, the demo: the group's guid (WTDD_CHAT_GUID's value) makes the group the on-call target (the flag goes there, a member's first clear reply decides); unset = the 1:1 above
WTDD_SHIFT=            # optional: the shift id every chat.post and reply row carries; default today's date YYYY-MM-DD; a run started from the remote (shift.json) wins
# 16 · blob-labels
WTDD_BLOBS_LABEL=live   # live = at a press (POST /dog/blobs) one llm.generate (vision) and one Jev Choice per blob in view (needs OPENROUTER_API_KEY, JEV_API_KEY, WTDD_CAM_FOV_DEG); stub = the DEMO_CACHE: unknown at p 0, no model, rows cached=true source=stub; anything else = every label FAILED (a failed row each)
WTDD_BLOBS=   # DEMO_CACHE: a {labels: [...]} file served by GET /dog/blobs and erased into GET /dog/floorplan instead of the session's labels (wtdd/dog/fixtures/blobs.json); empty = live
# 17 · decision-to-action
WTDD_REPLY_THRESHOLD=0.8   # a reply read below this, or unclear, is asked once more ("do you know them? yes or no"), then stands down; never an alarm
# 19 · scout-zones
WTDD_SCOUT=   # DEMO_CACHE: a GET /dog/scout body served instead of the session (wtdd/dog/fixtures/scout.json | scout-failed.json) for the page's dry check; empty = live (the scout reads JEV_API_KEY, JEV_MODEL and WTDD_DECIDE_THRESHOLD, 02's keys)
